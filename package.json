{
  "name": "runner-atlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build --config site/vite.config.ts",
    "preview": "vite preview --config site/vite.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "e2e": "playwright test",
    "collect:local": "node collector/src/collect.ts --local --out .tmp/sample.json",
    "synthetic": "node scripts/synthetic/generate.ts",
    "audit:screenshots": "node scripts/audit/screenshots.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-axis": "^3.0.6",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource-variable/hepta-slab": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "ajv": "^8.20.0",
    "d3-array": "^3.2.5",
    "d3-axis": "^3.0.1",
    "d3-contour": "^4.0.3",
    "d3-geo": "^3.1.2",
    "d3-interpolate": "^3.0.2",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.3",
    "d3-selection": "^3.0.1",
    "d3-shape": "^3.2.1",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
