{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "runner-atlas/drift@1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "runner-atlas/drift@1"
    },
    "range": {
      "anyOf": [
        {
          "$ref": "#/$defs/dateRange"
        },
        {
          "type": "null"
        }
      ]
    },
    "n": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "runs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "samples",
        "runs"
      ]
    },
    "weekdayHour": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/weekdayHourCell"
      },
      "minItems": 168,
      "maxItems": 168
    },
    "byHour": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hourCell"
      },
      "minItems": 24,
      "maxItems": 24
    },
    "byLabel": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "$ref": "#/$defs/runnerLabel"
          },
          "byHour": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "hourUtc": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 23
                },
                "runs": {
                  "type": "integer",
                  "minimum": 0
                },
                "queue": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/q4"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "hourUtc",
                "runs",
                "queue"
              ]
            },
            "maxItems": 24
          }
        },
        "required": [
          "label",
          "byHour"
        ]
      },
      "maxItems": 6
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "granularity": {
          "enum": [
            "hour",
            "weekday-hour",
            null
          ]
        },
        "best": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slotScore"
          },
          "maxItems": 5
        },
        "worst": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slotScore"
          },
          "maxItems": 5
        }
      },
      "required": [
        "granularity",
        "best",
        "worst"
      ]
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected": {
          "type": "integer",
          "minimum": 0
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "missedByHour": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "maxItems": 24
        }
      },
      "required": [
        "expected",
        "observed",
        "missedByHour"
      ]
    },
    "terrain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "contours": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "min",
        "max",
        "contours"
      ]
    }
  },
  "required": [
    "schema",
    "range",
    "n",
    "weekdayHour",
    "byHour",
    "byLabel",
    "ranking",
    "slots",
    "terrain"
  ],
  "$defs": {
    "runnerLabel": {
      "enum": [
        "ubuntu-24.04",
        "ubuntu-24.04-arm",
        "windows-2025",
        "windows-11-arm",
        "macos-15",
        "macos-15-intel"
      ]
    },
    "metricId": {
      "enum": [
        "singleCoreScore",
        "multiCoreScore",
        "seqWriteMBs",
        "seqReadMBs",
        "memBandwidthGBs",
        "netTtfbMs",
        "netMbps"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "dateRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/date"
        },
        "to": {
          "$ref": "#/$defs/date"
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "ci95": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2
    },
    "q4": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "median": {
          "type": "number"
        },
        "p25": {
          "type": "number"
        },
        "p75": {
          "type": "number"
        },
        "p95": {
          "type": "number"
        }
      },
      "required": [
        "median",
        "p25",
        "p75",
        "p95"
      ]
    },
    "q5": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "p10": {
          "type": "number"
        },
        "p25": {
          "type": "number"
        },
        "p50": {
          "type": "number"
        },
        "p75": {
          "type": "number"
        },
        "p90": {
          "type": "number"
        }
      },
      "required": [
        "p10",
        "p25",
        "p50",
        "p75",
        "p90"
      ]
    },
    "familyCount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "n": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "family",
        "n"
      ]
    },
    "slotScore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weekday": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 6
        },
        "hourUtc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "runs": {
          "type": "integer",
          "minimum": 3
        },
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "medianSec": {
          "type": "number"
        },
        "p90Sec": {
          "type": "number"
        },
        "score": {
          "type": "number"
        },
        "ci95": {
          "$ref": "#/$defs/ci95"
        }
      },
      "required": [
        "weekday",
        "hourUtc",
        "runs",
        "samples",
        "medianSec",
        "p90Sec",
        "score",
        "ci95"
      ]
    },
    "weekdayHourCell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weekday": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "hourUtc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "runs": {
          "type": "integer",
          "minimum": 0
        },
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "drift": {
          "anyOf": [
            {
              "$ref": "#/$defs/q4"
            },
            {
              "type": "null"
            }
          ]
        },
        "queue": {
          "anyOf": [
            {
              "$ref": "#/$defs/q4"
            },
            {
              "type": "null"
            }
          ]
        },
        "total": {
          "anyOf": [
            {
              "$ref": "#/$defs/q4"
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ]
        },
        "ci95": {
          "anyOf": [
            {
              "$ref": "#/$defs/ci95"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "weekday",
        "hourUtc",
        "runs",
        "samples",
        "drift",
        "queue",
        "total",
        "score",
        "ci95"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "runs": {
                "type": "integer",
                "maximum": 0
              }
            }
          },
          "then": {
            "properties": {
              "drift": {
                "type": "null"
              },
              "queue": {
                "type": "null"
              },
              "total": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "runs": {
                "type": "integer",
                "maximum": 2
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "null"
              },
              "ci95": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "hourCell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weekday": {
          "type": "null"
        },
        "hourUtc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "runs": {
          "type": "integer",
          "minimum": 0
        },
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "drift": {
          "anyOf": [
            {
              "$ref": "#/$defs/q4"
            },
            {
              "type": "null"
            }
          ]
        },
        "queue": {
          "anyOf": [
            {
              "$ref": "#/$defs/q4"
            },
            {
              "type": "null"
            }
          ]
        },
        "total": {
          "anyOf": [
            {
              "$ref": "#/$defs/q4"
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ]
        },
        "ci95": {
          "anyOf": [
            {
              "$ref": "#/$defs/ci95"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "weekday",
        "hourUtc",
        "runs",
        "samples",
        "drift",
        "queue",
        "total",
        "score",
        "ci95"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "runs": {
                "type": "integer",
                "maximum": 0
              }
            }
          },
          "then": {
            "properties": {
              "drift": {
                "type": "null"
              },
              "queue": {
                "type": "null"
              },
              "total": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "runs": {
                "type": "integer",
                "maximum": 2
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "null"
              },
              "ci95": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
