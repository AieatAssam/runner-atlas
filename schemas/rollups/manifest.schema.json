    "runnerLabel": {
      "enum": [
        "ubuntu-24.04",
        "ubuntu-24.04-arm",
        "windows-2025",
        "windows-11-arm",
        "macos-15",
        "macos-15-intel"
      ]
    },
    "metricId": {
      "enum": [
        "singleCoreScore",
        "multiCoreScore",
        "seqWriteMBs",
        "seqReadMBs",
        "memBandwidthGBs",
        "netTtfbMs",
        "netMbps"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "dateRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/date"
        },
        "to": {
          "$ref": "#/$defs/date"
        }
      },
      "required": [
